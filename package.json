{
	"name": "dprint-check-action",
	"version": "3.0.0",
	"private": true,
	"description": "GitHub Action to install dprint with caching and check formatting",
	"type": "module",
	"imports": {
		"#*": "./src/*.ts",
		"#lib/*": "./src/lib/*.ts",
		"#action.yml": {
			"types": "./action.yml.d.ts",
			"default": "./action.yml"
		},
		"#pkg": "./package.json"
	},
	"repository": "https://github.com/dprint/check",
	"scripts": {
		"biome:check": "biome check",
		"build": "tsdown",
		"check": "run --sequential fmt:check biome:check typecheck test",
		"fmt": "dprint fmt",
		"fmt:check": "dprint check",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"detect-libc": "^2.1.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/bun": "^1.4",
		"@types/node": "^24",
		"runner-run": "^0.25.1",
		"tsdown": ">=0.22",
		"typescript": "^7"
	},
	"packageManager": "bun@1.4.0",
	"engines": {
		"node": "24"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24",
			"onFail": "download"
		},
		"packageManager": {
			"name": "bun",
			"version": ">=1.4",
			"onFail": "error"
		}
	},
	"volta": {
		"node": "24.19.0"
	}
}
