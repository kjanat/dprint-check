{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"includes": ["**", "!!**/dist"]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": { "useLiteralKeys": "off" },
			"suspicious": { "noTemplateCurlyInString": "off" }
		}
	},
	"javascript": {},
	"assist": {
		"enabled": true,
		"actions": { "source": { "organizeImports": "off" } }
	}
}
